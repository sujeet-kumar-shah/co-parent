# MongoDB Connection
# For local MongoDB:
MONGODB_URI=mongodb://localhost:27017/co-parents
# For MongoDB Atlas (Cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/co-parents?retryWrites=true&w=majority

# Server Configuration
PORT=5000

# JWT Secret - CHANGE THIS IN PRODUCTION!
# Generate a secure secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-secure-random-string

# Cookie Secret - CHANGE THIS IN PRODUCTION!
COOKIE_SECRET=change-this-to-another-secure-random-string

# Frontend URL for CORS
# For local development:
FRONTEND_URL=http://localhost:5173
# For production:
# FRONTEND_URL=http://68.183.85.8:3000

# Twilio Configuration (Optional - for SMS features)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number
